package components

import (
	"fmt"
	"github.com/prathxm/mercato/internal/db"
)

templ ItemRow(item db.Item, isShop bool, isDone bool) {
	<div class={ "flex items-center gap-3 p-4 bg-white border rounded-2xl shadow-sm transition-all duration-300",
		templ.KV("border-slate-200 hover:border-indigo-200 hover:shadow-md", item.Status == "pending"),
		templ.KV("opacity-60 bg-slate-50 border-slate-100", item.Status == "bought" || item.Status == "unavailable") }
		id={ fmt.Sprintf("item-%d", item.ID) }>

		<!-- Status indicator dot -->
		<div class={ "flex-shrink-0 w-2.5 h-2.5 rounded-full mt-0.5",
			templ.KV("bg-indigo-400", item.Status == "pending"),
			templ.KV("bg-emerald-400", item.Status == "bought"),
			templ.KV("bg-rose-400", item.Status == "unavailable") }></div>

		<!-- Item info -->
		<div class="flex-grow min-w-0">
			<div class="flex flex-wrap items-center gap-2">
				<span class={ "font-semibold text-base leading-tight",
					templ.KV("text-slate-800", item.Status == "pending"),
					templ.KV("line-through text-slate-400", item.Status == "bought" || item.Status == "unavailable") }>
					{ item.Name }
				</span>
				if item.Quantity != "" {
					<span class="text-xs font-bold text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded-full uppercase tracking-wide">
						{ item.Quantity }
					</span>
				}
			</div>
			if item.Price > 0 {
				<div class="text-xs text-emerald-600 font-semibold mt-1">
					Paid: ${ fmt.Sprintf("%.2f", item.Price) }
				</div>
			}
			if item.Status == "unavailable" {
				<div class="text-xs text-rose-500 font-semibold mt-1">
					Not Available
				</div>
			}
		</div>

		<!-- Actions -->
		<div class="flex-shrink-0 flex items-center gap-2">
			if isShop {
				if item.Status == "pending" {
					<div class="flex items-center gap-2">
						<form hx-post={ fmt.Sprintf("/shop/buy/%d", item.ID) } hx-swap="none" class="flex items-center gap-2">
							<div class="relative">
								<span class="absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm font-medium select-none">$</span>
								<input type="number" step="0.01" name="price" placeholder="0.00" required
									class="w-20 pl-6 pr-2 py-2.5 border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent text-sm font-semibold bg-slate-50"/>
							</div>
							<button type="submit"
								class="bg-emerald-500 hover:bg-emerald-600 active:scale-95 text-white p-2.5 rounded-xl shadow-sm shadow-emerald-200 transition-all"
								title="Mark as bought">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
							</button>
						</form>
						<button hx-post={ fmt.Sprintf("/shop/unavailable/%d", item.ID) } hx-swap="none"
							class="p-2.5 text-slate-400 hover:text-rose-500 hover:bg-rose-50 active:bg-rose-100 rounded-xl transition-colors"
							title="Mark as unavailable">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle>
								<line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
							</svg>
						</button>
					</div>
				} else if item.Status == "bought" {
					<span class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 text-xs font-bold px-3 py-1.5 rounded-xl border border-emerald-100">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
						</svg>
						Bought
					</span>
				} else if item.Status == "unavailable" {
					<span class="inline-flex items-center gap-1.5 bg-rose-50 text-rose-700 text-xs font-bold px-3 py-1.5 rounded-xl border border-rose-100">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<circle cx="12" cy="12" r="10"></circle>
							<line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
						</svg>
						Not Available
					</span>
				}
			} else {
				if item.Status == "bought" || item.Status == "unavailable" {
					<span class="inline-flex items-center gap-1.5 bg-slate-100 text-slate-400 text-xs font-bold px-3 py-1.5 rounded-xl border border-slate-200">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
						</svg>
						if item.Status == "bought" {
							Got it
						} else {
							Unavailable
						}
					</span>
				}
				if item.Status == "pending" && !isDone {
					<!-- Delete always visible on mobile, hover-only on desktop -->
					<button hx-delete={ fmt.Sprintf("/item/%d", item.ID) } hx-swap="none"
						class="p-2 text-slate-300 hover:text-rose-500 hover:bg-rose-50 active:bg-rose-100 rounded-xl transition-colors"
						aria-label="Delete item">
						<svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
							<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
						</svg>
					</button>
				}
			}
		</div>
	</div>
}

templ ItemList(items []db.Item, isShop bool, isDone bool) {
	<div id="grocery-list" class="space-y-2.5">
		for _, item := range items {
			@ItemRow(item, isShop, isDone)
		}
		if len(items) == 0 {
			@EmptyState(isShop)
		}
	</div>
}

templ EmptyState(isShop bool) {
	<div id="empty-list-placeholder" class="text-center py-16 px-4">
		<div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-slate-100 mb-4">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
			</svg>
		</div>
		<p class="text-slate-400 font-semibold text-base">Your list is empty</p>
		if !isShop {
			<p class="text-slate-300 text-sm mt-1">Add your first item above</p>
		} else {
			<p class="text-slate-300 text-sm mt-1">Nothing to shop for yet</p>
		}
	</div>
}
