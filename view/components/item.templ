package components

import (
	"fmt"
	"sort"
	"github.com/prathxm/mercato/internal/db"
	"github.com/prathxm/mercato/internal/i18n"
)

templ ItemRow(item db.Item, isShop bool, isDone bool, currency string) {
	<div class={ "p-4 bg-white dark:bg-slate-900 border rounded-2xl shadow-sm transition-all duration-300",
		templ.KV("border-slate-100 dark:border-slate-800 hover:border-blue-200 dark:hover:border-blue-500 hover:shadow-md dark:hover:bg-slate-800/80", item.Status == "pending"),
		templ.KV("opacity-70 bg-slate-50 dark:bg-slate-900/40 border-slate-100 dark:border-slate-800/40", item.Status == "bought" || item.Status == "unavailable") }
		id={ fmt.Sprintf("item-%d", item.ID) }>
		
		<div class="flex flex-col sm:flex-row sm:items-center gap-4">
			<!-- Leading: Status & Name -->
			<div class="flex items-start gap-3 flex-grow min-w-0">
				<div class={ "flex-shrink-0 w-2 h-2 rounded-full mt-2",
					templ.KV("bg-blue-500 dark:bg-blue-400", item.Status == "pending"),
					templ.KV("bg-emerald-500", item.Status == "bought"),
					templ.KV("bg-rose-500", item.Status == "unavailable") }></div>
				
				<div class="flex-grow min-w-0">
					<div class="flex flex-wrap items-center gap-2">
						<span class={ "font-bold text-lg leading-tight tracking-tight",
							templ.KV("text-slate-900 dark:text-slate-100", item.Status == "pending"),
							templ.KV("line-through text-slate-400 dark:text-slate-600", item.Status == "bought" || item.Status == "unavailable") }>
							{ item.Name }
						</span>
						if item.Quantity != "" {
							<span class="text-[10px] font-black text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/40 px-2 py-0.5 rounded-lg uppercase tracking-wider">
								{ item.Quantity }
							</span>
						}
						if item.Category != "" {
							<span class="text-[9px] font-black text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-800 px-2 py-0.5 rounded-lg uppercase tracking-widest leading-none">
								{ item.Category }
							</span>
						}
					</div>
					if item.Price > 0 {
						<div class="text-xs text-emerald-600 dark:text-emerald-500 font-bold mt-1.5 flex items-center gap-1">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
							</svg>
							{ i18n.T(i18n.GetLang(ctx), "list.paid", fmt.Sprintf("%s%.2f", currency, item.Price)) }
						</div>
					}
					if item.Status == "unavailable" {
						<div class="text-[10px] text-rose-500 font-black uppercase tracking-wider mt-1.5 flex items-center gap-1">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
							</svg>
							{ i18n.T(i18n.GetLang(ctx), "shop.unavailable") }
						</div>
					}
				</div>
			</div>

			<!-- Trailing: Actions -->
			<div class="flex items-center justify-end gap-2 sm:flex-shrink-0">
				if isShop {
					if item.Status == "pending" {
						<div class="flex items-center gap-2 w-full sm:w-auto">
							<form hx-post={ fmt.Sprintf("/shop/buy/%d", item.ID) } hx-swap="none" class="flex items-center gap-2 flex-grow">
								<div class="relative flex-grow sm:flex-grow-0">
									<span class="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 dark:text-slate-600 text-sm font-bold select-none">{ currency }</span>
									<input type="number" step="0.01" name="price" placeholder="0.00" required
										class="w-full sm:w-24 pl-7 pr-3 py-3 border-2 border-slate-100 dark:border-slate-800 rounded-2xl focus:outline-none focus:border-blue-400 dark:focus:border-blue-500 text-sm font-black bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-white transition-all"/>
								</div>
								<button type="submit"
									class="bg-emerald-500 dark:bg-emerald-600 hover:bg-emerald-600 dark:hover:bg-emerald-500 active:scale-95 text-white p-3.5 rounded-2xl shadow-lg shadow-emerald-100 dark:shadow-none transition-all flex-shrink-0"
									title="Mark as bought">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
									</svg>
								</button>
							</form>
							<button hx-post={ fmt.Sprintf("/shop/unavailable/%d", item.ID) } hx-swap="none"
								class="p-3.5 text-slate-400 dark:text-slate-600 hover:text-rose-500 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 active:bg-rose-100 dark:active:bg-rose-900/40 rounded-2xl transition-all flex-shrink-0"
								title="Mark as unavailable">
								<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
								</svg>
							</button>
						</div>
					} else {
						<div class="flex items-center gap-1.5 opacity-100">
							if item.Status == "bought" {
								<span class="inline-flex items-center gap-1.5 bg-emerald-50 dark:bg-emerald-900/20 text-emerald-600 dark:text-emerald-400 text-[10px] font-black px-3 py-1.5 rounded-lg border border-emerald-100 dark:border-emerald-800/40 uppercase tracking-widest">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 20 20" fill="currentColor">
										<path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
									</svg>
									{ i18n.T(i18n.GetLang(ctx), "shop.bought") }
								</span>
							} else if item.Status == "unavailable" {
								<span class="inline-flex items-center gap-1.5 bg-rose-50 dark:bg-rose-900/20 text-rose-600 dark:text-rose-400 text-[10px] font-black px-3 py-1.5 rounded-lg border border-rose-100 dark:border-rose-800/40 uppercase tracking-widest">
									<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
										<circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
									</svg>
									{ i18n.T(i18n.GetLang(ctx), "shop.unavailable") }
								</span>
							}
						</div>
					}
				} else {
					if item.Status == "bought" || item.Status == "unavailable" {
						<span class="inline-flex items-center gap-1.5 bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-black px-2.5 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 uppercase tracking-widest leading-none">
							if item.Status == "bought" {
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								{ i18n.T(i18n.GetLang(ctx), "shop.bought") }
							} else {
								<svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-rose-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
									<circle cx="12" cy="12" r="10"></circle><line x1="4.93" y1="4.93" x2="19.07" y2="19.07"></line>
								</svg>
								{ i18n.T(i18n.GetLang(ctx), "shop.unavailable") }
							}
						</span>
					}
					if item.Status == "pending" && !isDone {
						<button hx-delete={ fmt.Sprintf("/item/%d", item.ID) } hx-swap="none"
							class="p-2.5 text-slate-300 dark:text-slate-700 hover:text-rose-500 dark:hover:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-900/20 active:scale-90 rounded-xl transition-all flex-shrink-0"
							aria-label="Delete item">
							<svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" viewBox="0 0 20 20" fill="currentColor">
								<path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd"/>
							</svg>
						</button>
					}
				}
			</div>
		</div>
	</div>
}

templ ItemList(items []db.Item, isShop bool, isDone bool, currency string) {
	<div id="grocery-list" class="space-y-6">
		if len(items) == 0 {
			@EmptyState(isShop)
		} else {
			for _, category := range getSortedCategories(items) {
				<div class="space-y-2">
					if category != "" {
						<h3 class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-[0.2em] px-1">{ category }</h3>
					}
					for _, item := range getItemsByCategory(items, category) {
						@ItemRow(item, isShop, isDone, currency)
					}
				</div>
			}
		}
	</div>
}

func getSortedCategories(items []db.Item) []string {
	catsMap := make(map[string]bool)
	var cats []string
	for _, item := range items {
		if !catsMap[item.Category] {
			catsMap[item.Category] = true
			cats = append(cats, item.Category)
		}
	}
	// Sort categories: empty string first, then alphabetical
	sort.Slice(cats, func(i, j int) bool {
		if cats[i] == "" {
			return true
		}
		if cats[j] == "" {
			return false
		}
		return cats[i] < cats[j]
	})
	return cats
}

func getItemsByCategory(items []db.Item, category string) []db.Item {
	var filtered []db.Item
	for _, item := range items {
		if item.Category == category {
			filtered = append(filtered, item)
		}
	}
	return filtered
}

templ EmptyState(isShop bool) {
	<div id="empty-list-placeholder" class="text-center py-20 px-6 bg-slate-50 dark:bg-slate-900/40 rounded-[2.5rem] border-2 border-dashed border-slate-100 dark:border-slate-800/60 mt-4 transition-colors">
		<div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-white dark:bg-slate-800 shadow-xl shadow-slate-200/50 dark:shadow-none mb-6">
			<svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-blue-500/40 dark:text-blue-400/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" />
			</svg>
		</div>
		<h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">{ i18n.T(i18n.GetLang(ctx), "list.empty") }</h3>
		if !isShop {
			<p class="text-slate-400 dark:text-slate-500 text-sm font-medium leading-relaxed max-w-[200px] mx-auto">{ i18n.T(i18n.GetLang(ctx), "list.empty_cta") }</p>
		} else {
			<p class="text-slate-400 dark:text-slate-500 text-sm font-medium leading-relaxed max-w-[200px] mx-auto">{ i18n.T(i18n.GetLang(ctx), "shop.empty_cta") }</p>
		}
	</div>
}
